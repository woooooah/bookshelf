# Kopiraj v .env in po potrebi spremeni
CORS_ORIGINS=http://localhost:5173

# Supabase: Connect -> Session pooler (ne Direct connection, ta deluje samo prek IPv6)
# Posebne znake v geslu (@, #, / ...) je treba zakodirati, npr. @ -> %40
DATABASE_URL=postgresql://postgres.PROJEKT_ID:GESLO@aws-0-REGIJA.pooler.supabase.com:5432/postgres

# Firebase: Project settings -> Service accounts -> Generate new private key.
# Datoteko shrani v backend/ (je v .gitignore, ne commitaj je).
FIREBASE_CREDENTIALS=firebase-service-account.json
